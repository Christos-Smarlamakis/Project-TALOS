# ============================================================================
# Project TALOS v5.12.3 -- Environment Configuration Canon (Template)
# ----------------------------------------------------------------------------
# SECURITY: Copy this file to .env and fill in ONLY the keys you intend to use.
# NEVER commit .env to version control. NEVER hardcode API keys in settings.py
# or config.json. This template contains ZERO secrets.
#
# CONVENTION: values MUST NOT be wrapped in quotes. load_dotenv does not strip
# quotes, so "local_first" would embed the quote glyphs into the value itself.
# Every key below is OPTIONAL. Air-gapped local mode works with zero keys.
#
# Docker note: inside a container, point model base URLs at the host machine
# via host.docker.internal (see docs/DOCKER.md).
# ============================================================================


# ============================================================================
# SECTION 1: EXECUTION MATRIX & NETWORK STRATEGY
# ----------------------------------------------------------------------------
# TALOS_NETWORK_STRATEGY controls where inference is routed:
#   strict_local : air-gapped; cloud providers are never called.
#   local_first  : local tiers primary, automatic cloud fallback.
#   cloud_first  : cloud providers primary, automatic local fallback.
#   strict_cloud : pure cloud; local tiers are never called. Preserves 100% of
#                  GPU VRAM for external DL workloads (ST-GNNs, HMADRL).
#   auto_dynamic : v5.10.14 Autonomous Execution Matrix (runtime resolution).
# TALOS_HARDWARE_STRATEGY controls which local device is used:
#   cpu_only (all on 11435), gpu_only (all on 11434), cpu_gpu_split (default).
# TALOS_FAST_ROUTING / TALOS_HEAVY_ROUTING: "local" or "cloud" per tier.
# ============================================================================
TALOS_NETWORK_STRATEGY=local_first
TALOS_HARDWARE_STRATEGY=cpu_gpu_split
TALOS_FAST_ROUTING=local
TALOS_HEAVY_ROUTING=local
TALOS_CLOUD_PROVIDER=gemini
# Air-gapped switch: set to 1 to disable all cloud fallback.
TALOS_USE_LOCAL=1
TALOS_ALLOW_CLOUD_FALLBACK=0
# Default request tier: "fast" or "heavy".
TALOS_DEFAULT_TIER=fast
# DEPRECATED (v5.9.4): retained for backward compatibility only.
TALOS_EXECUTION_MODE=local


# ============================================================================
# SECTION 2: LOCAL AI RUNTIME (Zero-Key, Zero-Internet)
# ----------------------------------------------------------------------------
# The local tier is the primary, air-gapped inference surface. It requires no
# API keys and no internet access when TALOS_USE_LOCAL=1.
#
# Verified models: llama3.1:8b (GPU chat), qwen2.5:14b (heavy reasoning),
# gemma3:12b (legacy alternate), nomic-embed-text (embeddings).
# Provision once with:  ollama pull llama3.1:8b
#                       ollama pull qwen2.5:14b
#                       ollama pull nomic-embed-text
#
# NOTE: the auto-start flag is a config.json boolean ("auto_start_local_llm":
# true), NOT an .env key. When the runtime is offline, AIManager probes
# http://127.0.0.1:11434/api/tags and (if enabled) spawns "ollama serve".
# ============================================================================
LOCAL_GPU_MODEL=llama3.1:8b
LOCAL_MODEL_NAME=gemma3:12b
LOCAL_EMBEDDING_MODEL=nomic-embed-text
# Standard Ollama endpoint for the heavy reasoning tier (port 11434, no /v1).
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Derived OpenAI-compatible local endpoint (OLLAMA_BASE_URL + /v1).
LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434/v1
HEAVY_REASONING_MODEL=qwen2.5:14b
# Fast CPU edge tier (dedicated endpoint on port 11435).
FAST_EDGE_MODEL=fermionresearch/Neutrino-8B
FAST_EDGE_BASE_URL=http://127.0.0.1:11435/v1


# ============================================================================
# SECTION 3: UNIVERSAL CLOUD AI MESH (9 PROVIDERS)
# ----------------------------------------------------------------------------
# OpenAI-compatible redundancy tier. Fill only the providers you intend to use.
# All keys are OPTIONAL. Missing keys park the provider as STANDBY_NO_KEY.
# Registration URLs are provided per provider. Base URLs are read from
# config/settings.py; the *_DEFAULT_MODEL keys override the default model.
# ============================================================================
# Google Gemini (primary; Google GenAI SDK). Free tier:
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_FLASH_MODEL=gemini-2.5-flash-lite
GEMINI_PRO_MODEL=gemini-2.5-pro
# DeepSeek (high-reasoning economy): https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_CHAT=deepseek-v4-pro
# HuggingFace Inference API: https://huggingface.co/settings/tokens
HF_TOKEN=
HF_MODEL_NAME=meta-llama/Llama-3.3-70B-Instruct
# NVIDIA NIM: https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_DEFAULT_MODEL=nvidia/nemotron-3-ultra
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
# Cerebras: https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_DEFAULT_MODEL=llama-3.1-70b
# GitHub Models (Personal Access Token): https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_MODELS_DEFAULT_MODEL=gpt-4o-mini
# Mistral: https://console.mistral.ai
MISTRAL_API_KEY=
MISTRAL_DEFAULT_MODEL=mistral-small-latest
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct:free


# ============================================================================
# SECTION 4: ACADEMIC INGESTION APIS (16 SOURCES)
# ----------------------------------------------------------------------------
# Category A (zero-key): arXiv, OpenAlex, DBLP, PubMed, Science.gov, OSTI,
# PLOS, OpenReview V2, OpenArchives (EADD), Crossref, OpenAIRE need no key.
# Crossref, OpenAlex, and PubMed read the "mailto" field from config.json
# (polite pool). The env fallbacks MAILTO / UNPAYWALL_EMAIL are optional.
#
# Category B (free developer registration):
#   Semantic Scholar  https://www.semanticscholar.org/product/api#api-key-form
#   CORE              https://core.ac.uk/services/api
#   Springer Nature   https://dev.springernature.com
#
# Category C (institutional / subscription):
#   IEEE Xplore       https://developer.ieee.org
#   Elsevier Scopus   https://dev.elsevier.com (via HEAL-Link / university
#                     proxy for Greek institutions; insttoken required).
# ============================================================================
IEEE_API_KEY=
ELSEVIER_API_KEY=
ELSEVIER_INST_TOKEN=
SPRINGER_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
CORE_API_KEY=
OPENREVIEW_USERNAME=
OPENREVIEW_PASSWORD=
OPENAIRE_TOKEN=
OPENARCHIVES_API_KEY=
# Unpaywall open-access PDF lookup (falls back to config.json mailto).
UNPAYWALL_EMAIL=
MAILTO=
# Optional author identity resolution (ORCID).
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
# Zotero reference manager bridge.
ZOTERO_API_KEY=
ZOTERO_USER_ID=


# ============================================================================
# SECTION 5: ECOSYSTEM INTEGRATIONS & PORT MAPPINGS
# ----------------------------------------------------------------------------
# Port map: 8001 TALOS FastAPI, 8000 SYNAPSE bus, 11434 Ollama GPU,
# 11435 Ollama CPU Edge, 8002 OPTICA bridge, 5002 legacy status endpoint.
# ============================================================================
SYNAPSE_BUS_URL=http://localhost:8000/api/v1/events
OPTICA_API_BASE=http://127.0.0.1:8002/api/v1
TALOS_API_PORT=8001


# ============================================================================
# SECTION 6: SYSTEM NOTIFICATIONS
# ----------------------------------------------------------------------------
# The daemon runs without any of these; it simply skips disabled channels.
# ============================================================================
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Email (SMTP) notifications.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=