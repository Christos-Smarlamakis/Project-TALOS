# TALOS v5.0.0 — .env Configuration
# Copy this file to .env and fill in your API keys.
# All keys are OPTIONAL except MAILTO (email for polite pools).

# ── Contact (Required) ──────────────────────────────────────────────────────
MAILTO = "your@email.com"

# ── Premium AI APIs (Optional) ──────────────────────────────────────────────
GEMINI_API_KEY = ""
DEEPSEEK_API_KEY = ""
HF_TOKEN = ""

# ── Integrations (Optional) ─────────────────────────────────────────────────
DISCORD_WEBHOOK_URL = ""
ZOTERO_API_KEY = ""
ZOTERO_USER_ID = ""

# ── Academic APIs (Optional — keyless sources work without these) ───────────
SEMANTIC_SCHOLAR_API_KEY = ""
SEMANTIC_SCHOLAR_API_KEY_basic = ""
IEEE_API_KEY = ""
SPRINGER_API_KEY = ""
ELSEVIER_API_KEY = ""
ELSEVIER_INST_TOKEN = ""
CORE_API_KEY = ""
OPENARCHIVES_API_KEY = ""

# ── ORCID (Optional) ────────────────────────────────────────────────────────
ORCID_CLIENT_ID = ""
ORCID_CLIENT_SECRET = ""

# ── Phase 4: Daemon Notifications (Optional) ────────────────────────────────
# The daemon runs without any of these — it simply skips disabled channels.
TELEGRAM_BOT_TOKEN =        # from @BotFather on Telegram
TELEGRAM_CHAT_ID =          # your personal or channel chat ID
SMTP_SERVER = smtp.gmail.com
SMTP_PORT = 587
SMTP_USERNAME =             # your Gmail address
SMTP_PASSWORD =             # Gmail App Password (NOT regular password)
SMTP_FROM =                 # same as SMTP_USERNAME
SMTP_TO =                   # recipient email for weekly digest

# ── Local Models (Optional) ─────────────────────────────────────────────────
LOCAL_MODEL_NAME = "gemma3:12b"
LOCAL_EMBEDDING_MODEL = "nomic-embed-text"
# OLLAMA_MODEL = ""          # Override model for generate_docs.py (falls back to LOCAL_MODEL_NAME)
