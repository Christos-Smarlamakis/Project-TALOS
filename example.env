# ============================================================================
# Project TALOS v5.10.13 -- Environment Configuration Canon
# ----------------------------------------------------------------------------
# Copy this file to .env and fill in only the keys you intend to use.
# Every key is OPTIONAL. Local-only (air-gapped) mode works with zero keys.
#
# Docker note: inside a container, point model base URLs at the host machine
# via host.docker.internal (see docs/DOCKER.md).
#
# Values MUST NOT be wrapped in quotes unless the value itself contains spaces.
# ============================================================================


# ============================================================================
# SECTION 1: EXECUTION MATRIX & NETWORK STRATEGY
# ----------------------------------------------------------------------------
# TALOS_NETWORK_STRATEGY controls where inference is routed:
#   strict_local : air-gapped; cloud providers are never called.
#   local_first  : local tiers primary, automatic cloud fallback.
#   cloud_first  : cloud providers primary, automatic local fallback.
#   strict_cloud : pure cloud; requires valid cloud API keys.
# TALOS_HARDWARE_STRATEGY controls which local compute devices are used:
#   cpu_only, gpu_only, cpu_gpu_split (default).
# TALOS_FAST_ROUTING / TALOS_HEAVY_ROUTING: "local" or "cloud" per tier.
# ============================================================================
TALOS_NETWORK_STRATEGY=local_first
TALOS_HARDWARE_STRATEGY=cpu_only
TALOS_FAST_ROUTING=local
TALOS_HEAVY_ROUTING=local
TALOS_CLOUD_PROVIDER=gemini
# Air-gapped switch: set to 1 to disable all cloud fallback.
TALOS_USE_LOCAL=1
TALOS_ALLOW_CLOUD_FALLBACK=0
# DEPRECATED (v5.9.4): retained for backward compatibility only.
TALOS_EXECUTION_MODE=local


# ============================================================================
# SECTION 2: LOCAL AI MODEL TIERS
# ----------------------------------------------------------------------------
# Fast edge model: lightweight, low-latency inference for pre-screening.
# Runs on a dedicated OpenAI-compatible endpoint (default port 11435).
# ============================================================================
FAST_EDGE_MODEL=fermionresearch/Neutrino-8B
FAST_EDGE_BASE_URL=http://127.0.0.1:11435/v1
# Heavy reasoning model: larger model for deep analysis and synthesis.
HEAVY_REASONING_MODEL=qwen2.5:14b
# Standard Ollama instance for the heavy reasoning tier (port 11434).
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Local embedding model used for semantic search vectors.
LOCAL_EMBEDDING_MODEL=nomic-embed-text
# Legacy local model names (used by the ai_manager init path).
LOCAL_MODEL_NAME=gemma3:12b
LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434/v1


# ============================================================================
# SECTION 3: UNIVERSAL CLOUD MESH (9 PROVIDERS)
# ----------------------------------------------------------------------------
# OpenAI-compatible redundancy tier. Fill only the providers you intend to use.
# All keys are OPTIONAL: local-only mode works with zero keys.
# ============================================================================
# Google Gemini (primary; uses the Google Generative AI SDK).
GEMINI_API_KEY=
GEMINI_FLASH_MODEL=gemini-2.5-flash-lite
GEMINI_PRO_MODEL=gemini-2.5-pro
# NVIDIA NIM
NVIDIA_API_KEY=
NVIDIA_DEFAULT_MODEL=nvidia/nemotron-3-ultra
# Groq
GROQ_API_KEY=
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
# Cerebras
CEREBRAS_API_KEY=
CEREBRAS_DEFAULT_MODEL=llama-3.1-70b
# GitHub Models
GITHUB_TOKEN=
GITHUB_MODELS_DEFAULT_MODEL=gpt-4o-mini
# Mistral
MISTRAL_API_KEY=
MISTRAL_DEFAULT_MODEL=mistral-small-latest
# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct:free
# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_CHAT=deepseek-chat
# HuggingFace Inference API
HF_TOKEN=
HF_MODEL_NAME=meta-llama/Llama-3.3-70B-Instruct


# ============================================================================
# SECTION 4: 16 ACADEMIC INGESTION APIS
# ----------------------------------------------------------------------------
# Keyless sources (arXiv, Crossref, OpenAlex, DBLP, PubMed, PLOS, OSTI,
# SciGov, OpenArchives) work without any of these keys. The keys below unlock
# higher rate limits or authentication-gated endpoints.
# ============================================================================
IEEE_API_KEY=
ELSEVIER_API_KEY=
ELSEVIER_INST_TOKEN=
SPRINGER_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_API_KEY_basic=
CORE_API_KEY=
OPENREVIEW_USERNAME=
OPENREVIEW_PASSWORD=
OPENAIRE_TOKEN=
OPENARCHIVES_API_KEY=
# ORCID (optional author identity resolution).
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
# Zotero reference manager bridge.
ZOTERO_API_KEY=
ZOTERO_USER_ID=


# ============================================================================
# SECTION 5: ECOSYSTEM INTEGRATIONS
# ----------------------------------------------------------------------------
# SYNAPSE event bus (sister microservice mesh on port 8000).
# ============================================================================
SYNAPSE_BUS_URL=http://localhost:8000/api/v1/events
# OPTICA Bridge base URL (sister visualization microservice on port 8002).
OPTICA_API_BASE=http://127.0.0.1:8002/api/v1
# TALOS FastAPI server port (port 8000 is reserved for SYNAPSE).
TALOS_API_PORT=8001


# ============================================================================
# SECTION 6: SYSTEM NOTIFICATIONS
# ----------------------------------------------------------------------------
# The daemon runs without any of these; it simply skips disabled channels.
# ============================================================================
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Email (SMTP) notifications.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=