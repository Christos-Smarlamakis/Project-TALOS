# TALOS v5.9.14 — .env Configuration
# Copy this file to .env and fill in your API keys.
# All keys are OPTIONAL. Local-only (air-gapped) mode works with zero keys.
#
# Docker note: when running inside a container, point the model base URLs at the
# host machine via host.docker.internal (see docs/DOCKER.md).

# ── Multi-Tier LLM Routing (v5.8.0+) ────────────────────────────────────────
# Fast edge model: lightweight, low-latency for pre-screening (port 11435).
FAST_EDGE_MODEL="fermionresearch/Neutrino-8B"
FAST_EDGE_BASE_URL="http://127.0.0.1:11435/v1"
# Heavy reasoning model: larger model for deep analysis (port 11434).
HEAVY_REASONING_MODEL="qwen2.5:14b"
# Base URL for standard Ollama instance.
OLLAMA_BASE_URL="http://127.0.0.1:11434"

# ── Execution Mode (v5.8.0+) ────────────────────────────────────────────────
# "local" = air-gapped, Ollama only.
# "hybrid" = local primary, cloud fallback.
# "cloud" = cloud primary, local fallback.
TALOS_EXECUTION_MODE="local"

# ── System Ports ─────────────────────────────────────────────────────────────
# TALOS FastAPI server port (avoids conflict with SYNAPSE bus on 8000).
TALOS_API_PORT=8001
# SYNAPSE event bus URL for ecosystem interoperability.
SYNAPSE_BUS_URL="http://localhost:8000/api/v1/events"

# ── Cloud Provider Selection (v5.8.0+) ───────────────────────────────────────
# "gemini" | "deepseek" | "huggingface" — used when TALOS_EXECUTION_MODE != "local".
TALOS_CLOUD_PROVIDER="gemini"

# ── Premium AI APIs (Optional) ──────────────────────────────────────────────
GEMINI_API_KEY=""
GEMINI_FLASH_MODEL="gemini-2.5-flash-lite"
GEMINI_PRO_MODEL="gemini-2.5-pro"
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL_CHAT="deepseek-chat"
HF_TOKEN=""
HF_MODEL_NAME="mistralai/Mixtral-8x7B-Instruct-v0.1"

# ── Contact (Required for polite academic pools) ─────────────────────────────
MAILTO="your@email.com"

# ── Integrations (Optional) ─────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=""
ZOTERO_API_KEY=""
ZOTERO_USER_ID=""

# ── Academic APIs (Optional — keyless sources work without these) ───────────
SEMANTIC_SCHOLAR_API_KEY=""
SEMANTIC_SCHOLAR_API_KEY_basic=""
IEEE_API_KEY=""
SPRINGER_API_KEY=""
ELSEVIER_API_KEY=""
ELSEVIER_INST_TOKEN=""
CORE_API_KEY=""
OPENARCHIVES_API_KEY=""

# ── ORCID (Optional) ────────────────────────────────────────────────────────
ORCID_CLIENT_ID=""
ORCID_CLIENT_SECRET=""

# ── Daemon Notifications (Optional) ─────────────────────────────────────────
# The daemon runs without any of these — it simply skips disabled channels.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# ── Local Models (Optional — Ollama fallback names) ─────────────────────────
LOCAL_MODEL_NAME="gemma3:12b"
LOCAL_EMBEDDING_MODEL="nomic-embed-text"