# TALOS v4.10.0 — .env Configuration
# Copy this file to .env and fill in your API keys.
# All keys are OPTIONAL except MAILTO (email for polite pools).

# ── Contact (Required) ──────────────────────────────────────────────────────
MAILTO = "your@email.com"

# ── Premium AI APIs (Optional) ──────────────────────────────────────────────
GEMINI_API_KEY = ""
DEEPSEEK_API_KEY = ""
HF_TOKEN = ""

# ── Integrations (Optional) ─────────────────────────────────────────────────
DISCORD_WEBHOOK_URL = ""
ZOTERO_API_KEY = ""
ZOTERO_USER_ID = ""

# ── Academic APIs (Optional — keyless sources work without these) ───────────
SEMANTIC_SCHOLAR_API_KEY = ""
SEMANTIC_SCHOLAR_API_KEY_basic = ""
IEEE_API_KEY = ""
SPRINGER_API_KEY = ""
ELSEVIER_API_KEY = ""
ELSEVIER_INST_TOKEN = ""
CORE_API_KEY = ""
OPENARCHIVES_API_KEY = ""

# ── ORCID (Optional) ────────────────────────────────────────────────────────
ORCID_CLIENT_ID = ""
ORCID_CLIENT_SECRET = ""

# ── Local Models (Optional) ─────────────────────────────────────────────────
LOCAL_MODEL_NAME = "gemma3:12b"
LOCAL_EMBEDDING_MODEL = "nomic-embed-text"