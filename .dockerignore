# TALOS v5.9.14 — Docker build exclusions
# These files and directories are excluded from the Docker build context
# to keep the image small, fast, and free of sensitive data.

# Sensitive / environment-specific (never in the image)
.env
*.db
config.json

# Runtime data (mounted as volumes at runtime)
data/
logs/
models/

# Research profiles (per-topic isolated databases and configs)
_profiles/

# Generated documentation (regenerate with: python src/utils/generate_docs.py)
docs/

# Frontend UI directories (standalone projects, not part of the API image)
cherry_ui_isolated/
frontend_ui/

# Python virtual environments (use the container's own Python)
venv/
.venv/

# VCS
.git/
.gitignore

# Agent instruction file (development only)
.clinerules

# IDE
.vscode/

# Python cache
__pycache__/
.pytest_cache/

# Reports (generated at runtime)
reports/